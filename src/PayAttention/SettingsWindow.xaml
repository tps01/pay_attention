<Window x:Class="PayAttention.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PayAttention.Core.Models;assembly=PayAttention.Core"
        Title="pay_attention — Settings"
        Height="760" Width="900"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <Window.Resources>
    <!-- Amber ⚠ shown beside settings that are likely costly on this PC. -->
    <Style x:Key="PerfWarningGlyph" TargetType="TextBlock">
      <Setter Property="Text" Value="⚠" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#B45309" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Cursor" Value="Help" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Import…" Width="90" Margin="0,0,8,0" Click="Import_Click" />
      <Button Content="Export…" Width="90" Margin="0,0,8,0" Click="Export_Click" />
      <Button Content="Open captures folder" Width="150" Margin="0,0,8,0" Click="OpenCaptures_Click" />
      <Button Content="Save" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
      <Button Content="Close" Width="90" IsCancel="True" Click="Close_Click" />
    </StackPanel>

    <TabControl x:Name="SettingsTabs">
      <TabItem Header="General">
        <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
          <StackPanel>
            <TextBlock Text="pay_attention" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Capture screenshots, screenshot sequences, or short recordings when trigger text appears on screen."
                       TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16" />

            <Expander Header="Triggers" IsExpanded="True" Margin="0,0,0,12" ExpandDirection="Down"
                      Padding="0,6,0,0">
              <DockPanel Margin="10,4,10,10">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Add" Width="80" Margin="0,0,8,0" Click="AddTrigger_Click" />
                  <Button Content="Remove" Width="80" Click="RemoveTrigger_Click" />
                </StackPanel>
                <DataGrid x:Name="TriggersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          MinHeight="160"
                          MaxHeight="280"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="On" Width="40">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Text" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTemplateColumn Header="Match" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox SelectedItem="{Binding Match, UpdateSourceTrigger=PropertyChanged}">
                            <models:MatchMode>Contains</models:MatchMode>
                            <models:MatchMode>Exact</models:MatchMode>
                            <models:MatchMode>Regex</models:MatchMode>
                          </ComboBox>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Action" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}">
                            <models:CaptureAction>Screenshot</models:CaptureAction>
                            <models:CaptureAction>Record</models:CaptureAction>
                            <models:CaptureAction>Sequence</models:CaptureAction>
                          </ComboBox>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="OCR" Width="90">
                      <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                          <Setter Property="ToolTip"
                                  Value="Fast (default): prefer fresh samples for briefly visible lines. Thorough: full OCR passes for hard-to-read static text." />
                        </Style>
                      </DataGridTemplateColumn.HeaderStyle>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox SelectedItem="{Binding OcrMode, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Fast (default): prefer fresh samples for briefly visible lines. Thorough: full OCR passes for hard-to-read static text.">
                            <models:OcrSpeedMode>Fast</models:OcrSpeedMode>
                            <models:OcrSpeedMode>Thorough</models:OcrSpeedMode>
                          </ComboBox>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Expander>

            <Expander Header="Applications" IsExpanded="True" Margin="0,0,0,12" ExpandDirection="Down"
                      Padding="0,6,0,0">
              <DockPanel Margin="10,4,10,10">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Add" Width="80" Margin="0,0,8,0" Click="AddApplication_Click" />
                  <Button Content="Remove" Width="80" Click="RemoveApplication_Click" />
                </StackPanel>
                <DataGrid x:Name="ApplicationsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          MinHeight="140"
                          MaxHeight="240"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="On" Width="40">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Application" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Pick…" Margin="6,0,0,0" Padding="8,2"
                                    Click="PickApplication_Click" Tag="{Binding}" />
                            <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                          </DockPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="List" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox SelectedItem="{Binding ListMode, UpdateSourceTrigger=PropertyChanged}">
                            <models:ApplicationListMode>Whitelist</models:ApplicationListMode>
                            <models:ApplicationListMode>Blacklist</models:ApplicationListMode>
                          </ComboBox>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Debounce" Binding="{Binding DebounceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    <DataGridTemplateColumn Header="Prep" Width="120">
                      <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                          <Setter Property="ToolTip"
                                  Value="Per-app OCR prep overrides (Inherit / Off / On / Auto) for adaptive, neon, gray, invert, and terminal passes." />
                        </Style>
                      </DataGridTemplateColumn.HeaderStyle>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <DockPanel LastChildFill="True"
                                     ToolTip="Per-app OCR prep (Inherit / Off / On / Auto). Edit to override global Advanced passes for this process.">
                            <Button DockPanel.Dock="Right" Content="Edit…" Margin="6,0,0,0" Padding="6,2"
                                    Click="EditApplicationOcrPrep_Click" Tag="{Binding}" />
                            <TextBlock Text="{Binding OcrPrepSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Triggers" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox SelectedItem="{Binding TriggerFilter, UpdateSourceTrigger=PropertyChanged}"
                                    DropDownOpened="TriggerFilterCombo_DropDownOpened"
                                    DropDownClosed="TriggerFilterCombo_DropDownClosed"
                                    ToolTip="All = every trigger; Selected = choose triggers; None = no triggers">
                            <models:ApplicationTriggerFilter>All</models:ApplicationTriggerFilter>
                            <models:ApplicationTriggerFilter>Selected</models:ApplicationTriggerFilter>
                            <models:ApplicationTriggerFilter>None</models:ApplicationTriggerFilter>
                          </ComboBox>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Expander>

            <GroupBox Header="Capture" Padding="10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Capture directory" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox x:Name="CaptureDirectoryBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Width="80" Margin="0,0,0,8" Click="BrowseCapture_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="OCR interval (ms)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Capture period between screen grabs. Use 250–500ms with Fast OCR for briefly visible terminal lines. Optimize for this PC may change this." />
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBox x:Name="OcrIntervalBox" Width="120" HorizontalAlignment="Left"
                           TextChanged="PerformanceHintField_Changed"
                           ToolTip="Capture period between screen grabs. Use 250–500ms with Fast OCR for briefly visible terminal lines. Optimize for this PC may change this." />
                  <TextBlock x:Name="OcrIntervalPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fast match threshold" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="For Fast OCR triggers only: how closely OCR text must match the trigger (similarity, not Windows OCR confidence). 100 is strictest; lower is more reactive but may false-fire. Thorough triggers ignore this." />
                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                           ToolTip="For Fast OCR triggers only: how closely OCR text must match the trigger (similarity, not Windows OCR confidence). 100 is strictest; lower is more reactive but may false-fire. Thorough triggers ignore this.">
                  <TextBlock x:Name="FastMatchThresholdLabel" DockPanel.Dock="Right" Width="44" VerticalAlignment="Center"
                             TextAlignment="Right" Margin="8,0,0,0" Text="90%" />
                  <Slider x:Name="FastMatchThresholdSlider"
                          Minimum="50" Maximum="100"
                          TickFrequency="5" IsSnapToTickEnabled="True"
                          SmallChange="5" LargeChange="10"
                          Value="90"
                          VerticalAlignment="Center"
                          ValueChanged="FastMatchThresholdSlider_ValueChanged" />
                </DockPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Debounce (seconds)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Minimum time before the same trigger can fire again when the screen has changed. Unchanged screens stay suppressed. Per-application debounce overrides this when that app is foreground." />
                <TextBox x:Name="DebounceBox" AutomationProperties.AutomationId="DebounceBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="Minimum time before the same trigger can fire again when the screen has changed. Unchanged screens stay suppressed. Per-application debounce overrides this when that app is foreground." />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Application scope" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Whitelist = only those apps (best for 'ignore everything else'). All minus blacklisted = skip when a fully blacklisted app is foreground, and mask those windows otherwise." />
                <ComboBox x:Name="ApplicationScopeBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                          DisplayMemberPath="Display" SelectedValuePath="Value"
                          ToolTip="Whitelist = only those apps (best for 'ignore everything else'). All minus blacklisted = skip when a fully blacklisted app is foreground, and mask those windows otherwise." />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Capture scope" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Monitor = chosen display(s). Foreground window = only the focused app (must stay focused; good for a terminal you are using)." />
                <ComboBox x:Name="CaptureScopeBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Width="200" HorizontalAlignment="Left"
                          ToolTip="Monitor = chosen display(s). Foreground window = only the focused app (must stay focused; good for a terminal you are using)." />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Screenshot format" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Jpeg is faster to save (default). Png is lossless." />
                <ComboBox x:Name="ScreenshotFormatBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                          ToolTip="Jpeg is faster to save (default). Png is lossless." />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Monitor" VerticalAlignment="Center"
                           ToolTip="Used when capture scope is Monitor. Primary/Specific are fastest. All scans every display (slower; avoid with Fast OCR on multi-monitor)." />
                <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2">
                  <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="MonitorModeBox" Width="140" Margin="0,0,8,0" SelectionChanged="MonitorMode_Changed"
                              ToolTip="Used when capture scope is Monitor. Primary/Specific are fastest. All scans every display (slower; avoid with Fast OCR on multi-monitor)." />
                    <ComboBox x:Name="SpecificMonitorBox" Width="280" Margin="0,0,8,0" />
                    <TextBlock x:Name="MonitorAllPerfHint" Style="{StaticResource PerfWarningGlyph}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock x:Name="MonitorAllPerfCaption" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                             Foreground="#B45309" Visibility="Collapsed"
                             Text="More than one monitor detected. Limiting capture scope to one monitor is recommended for optimal performance." />
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="Recording" Padding="10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Buffer length (seconds)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Seconds kept before a trigger (pre-roll)." />
                <TextBox x:Name="BufferSecondsBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="Seconds kept before a trigger (pre-roll)." />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame rate (FPS)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="How many frames per second to keep in the buffer." />
                <TextBox x:Name="RecordFpsBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="How many frames per second to keep in the buffer." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Format" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Avi = MJPEG video (default). Gif = animated GIF." />
                <ComboBox x:Name="RecordFormatBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                          ToolTip="Avi = MJPEG video (default). Gif = animated GIF." />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="JPEG quality" VerticalAlignment="Center"
                           ToolTip="40–95. Lower = smaller files, more artifacts. Used for the ring buffer and AVI." />
                <TextBox x:Name="RecordJpegQualityBox" Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                         ToolTip="40–95. Lower = smaller files, more artifacts. Used for the ring buffer and AVI." />
              </Grid>
            </GroupBox>

            <GroupBox Header="Screenshot sequence" Padding="10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Spacing (seconds)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Seconds between stills in a sequence (1–30)." />
                <TextBox x:Name="SequenceIntervalBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="Seconds between stills in a sequence (1–30)." />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Before trigger (seconds)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="How far back to keep stills before the trigger (0–60)." />
                <TextBox x:Name="SequenceBeforeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="How far back to keep stills before the trigger (0–60)." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="After trigger (seconds)" VerticalAlignment="Center"
                           ToolTip="How long to keep capturing stills after the trigger (0–60)." />
                <TextBox x:Name="SequenceAfterBox" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                         ToolTip="How long to keep capturing stills after the trigger (0–60)." />
              </Grid>
            </GroupBox>

            <GroupBox Header="Behavior" Padding="10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="StartWithWindowsBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Start with Windows" Margin="0,0,0,8" />
                <CheckBox x:Name="StartMonitoringBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Start monitoring on launch" Margin="0,0,0,8" />
                <CheckBox x:Name="DebugJsonBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Debug: save JSON sidecar with each capture" Margin="0,0,0,8"
                          ToolTip="Writes a .json next to each capture including OCR snippet text. Leave off unless troubleshooting — files can contain secrets." />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Log level" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Info = normal operation. Debug = OCR text snippets, enqueue/fingerprint, resample, and fire-gate reasons in the log files. Logs older than 5 days are deleted." />
                <ComboBox x:Name="LogLevelBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Width="180" HorizontalAlignment="Left"
                          ToolTip="Info = normal operation. Debug = OCR text snippets, enqueue/fingerprint, resample, and fire-gate reasons in the log files. Logs older than 5 days are deleted." />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Pause hotkey" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox x:Name="HotkeyBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Width="180" HorizontalAlignment="Left"
                         ToolTip="Example: Ctrl+Shift+P" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Retention max age (days)" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox x:Name="RetentionDaysBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="0 = do not delete by age" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Retention max files" VerticalAlignment="Center" />
                <TextBox x:Name="RetentionFilesBox" Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                         ToolTip="0 = do not delete by count" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Advanced" x:Name="AdvancedTab">
        <ScrollViewer x:Name="AdvancedScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
          <StackPanel>
            <TextBlock Text="Performance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                       Text="Pick a quality preset, or run Optimize for this PC (~10s) to time Very Low→Ultra on test windows. Either way, review the knobs below, then Save." />

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Quality preset" VerticalAlignment="Center"
                         ToolTip="Applies a named OCR performance profile to the fields below. Does not save until you click Save." />
              <ComboBox x:Name="QualityPresetBox" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                        SelectionChanged="QualityPresetBox_SelectionChanged"
                        ToolTip="Very Low → Ultra. Changing this fills the Advanced knobs from that profile; Save to apply." />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="Optimize for this PC…" Width="180" Margin="0,0,8,0"
                      Click="OptimizeForThisPc_Click"
                      ToolTip="About 10 seconds. Shows plain and neon test windows, times Very Low→Ultra (3 trials each), picks a profile for this hardware. Does not save until you click Save." />
              <Button Content="Reset performance to defaults" Width="200"
                      Click="ResetPerformance_Click"
                      ToolTip="Restore Ultra (default) performance knobs into the form without saving." />
            </StackPanel>
            <TextBlock x:Name="CalibrationSummaryText" TextWrapping="Wrap" Margin="0,0,0,16"
                       Opacity="0.85" Text="Not calibrated on this PC yet." />

            <GroupBox Header="OCR quality" Padding="10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="OCR max width (px)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Downscale width before OCR (960–3840). Higher = better OCR, more CPU." />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBox x:Name="OcrMaxWidthBox" Width="120" HorizontalAlignment="Left"
                           TextChanged="PerformanceHintField_Changed"
                           ToolTip="Downscale width before OCR (960–3840). Higher = better OCR, more CPU." />
                  <TextBlock x:Name="OcrMaxWidthPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="OCR upscale (%)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="100 = none. Try 150–250 for small terminal fonts (100–400)." />
                <TextBox x:Name="OcrUpscaleBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="100 = none. Try 150–250 for small terminal fonts (100–400)." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Boost upscale (%)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Floor for adaptive/neon passes; terminal/tiles/bands scale from this (100–400). Default 200." />
                <TextBox x:Name="OcrBoostUpscaleBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="Floor for adaptive/neon passes; terminal/tiles/bands scale from this (100–400). Default 200." />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Absolute max width (px)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Hard cap after upscale (960–3840). Keeps boosted OCR from becoming 4K-wide on weak PCs." />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBox x:Name="OcrAbsoluteMaxWidthBox" Width="120" HorizontalAlignment="Left"
                           TextChanged="PerformanceHintField_Changed"
                           ToolTip="Hard cap after upscale (960–3840). Keeps boosted OCR from becoming 4K-wide on weak PCs." />
                  <TextBlock x:Name="OcrAbsoluteMaxWidthPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>

                <CheckBox x:Name="OcrInvertBox" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                          Content="Extra invert pass for OCR"
                          ToolTip="Adds an invert-only OCR pass. Adaptive grayscale contrast and neon boost already run when enabled below; captures stay full color." />
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                  <CheckBox x:Name="OcrEnableGrayBox"
                            Content="Extra grayscale pass for OCR"
                            Checked="PerformanceHintCheck_Changed" Unchecked="PerformanceHintCheck_Changed"
                            ToolTip="Adds a plain luma grayscale OCR pass (no contrast stretch). Adaptive and neon passes already convert to gray when enabled below; captures stay full color." />
                  <TextBlock x:Name="OcrGrayPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>
              </Grid>
            </GroupBox>

            <TextBlock x:Name="MultiPassPerfBanner" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="11"
                       Foreground="#B45309" Visibility="Collapsed"
                       Text="⚠ Multiple extra OCR passes are enabled. Each pass increases per-frame cost and can exceed the Fast cascade budget." />

            <GroupBox Header="OCR cascade" Padding="10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                  <CheckBox x:Name="OcrEnableAdaptiveBox"
                            Content="Enable adaptive contrast pass"
                            Checked="PerformanceHintCheck_Changed" Unchecked="PerformanceHintCheck_Changed"
                            ToolTip="Second OCR pass with contrast stretch + invert." />
                  <TextBlock x:Name="OcrAdaptivePerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                  <CheckBox x:Name="OcrEnableNeonBox"
                            Content="Enable neon high-contrast pass"
                            Checked="PerformanceHintCheck_Changed" Unchecked="PerformanceHintCheck_Changed"
                            ToolTip="Third OCR pass tuned for neon-on-black terminals." />
                  <TextBlock x:Name="OcrNeonPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                  <CheckBox x:Name="OcrEnableTerminalBox"
                            Content="Enable terminal ROI passes"
                            Checked="PerformanceHintCheck_Changed" Unchecked="PerformanceHintCheck_Changed"
                            ToolTip="Crop dark terminal-like regions and re-OCR at higher scale." />
                  <TextBlock x:Name="OcrTerminalPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Terminal max regions" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="How many terminal-like crops to OCR (0–4)." />
                <TextBox x:Name="OcrTerminalMaxRegionsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="How many terminal-like crops to OCR (0–4)." />

                <TextBlock Visibility="Collapsed" Grid.Row="4" Grid.Column="0" Text="Max windows (All−blacklist)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Max windows OCR'd per frame in All Minus Blacklisted mode (1–12)." />
                <TextBox Visibility="Collapsed" x:Name="OcrMaxWindowsBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="Max windows OCR'd per frame in All Minus Blacklisted mode (1–12)." />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="OCR queue capacity" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Pending frames waiting for OCR (1–4). Takes effect after Save + monitoring restart." />
                <TextBox x:Name="OcrQueueCapacityBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="Pending frames waiting for OCR (1–4). Takes effect after Save + monitoring restart." />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Fast cascade budget (ms)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Stop searching a frame after this long when only Fast triggers remain (100–30000)." />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBox x:Name="OcrCascadeBudgetFastBox" Width="120" HorizontalAlignment="Left"
                           TextChanged="PerformanceHintField_Changed"
                           ToolTip="Stop searching a frame after this long when only Fast triggers remain (100–30000)." />
                  <TextBlock x:Name="OcrFastBudgetPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Thorough cascade budget (ms)" VerticalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Stop searching a frame after this long when Thorough triggers remain (100–60000)." />
                <TextBox x:Name="OcrCascadeBudgetThoroughBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"
                         ToolTip="Stop searching a frame after this long when Thorough triggers remain (100–60000)." />

                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                  <CheckBox x:Name="OcrApplyBudgetWhenIdleBox"
                            Content="Apply cascade budget even when idle (no backlog)"
                            Checked="PerformanceHintCheck_Changed" Unchecked="PerformanceHintCheck_Changed"
                            ToolTip="Off (High default): budgets only when newer frames are waiting. On: always cap cascade time." />
                  <TextBlock x:Name="OcrIdleBudgetPerfHint" Style="{StaticResource PerfWarningGlyph}" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="UseBackgroundPriorityBox" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Run capture/OCR at background priority"
                          ToolTip="BelowNormal thread priority so foreground apps stay responsive. Takes effect after Save + monitoring restart." />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
