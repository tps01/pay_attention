<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PayAttention</RootNamespace>
    <AssemblyName>PayAttention</AssemblyName>
    <Authors>tps01</Authors>
    <Company>tps01</Company>
    <Product>pay_attention</Product>
    <AssemblyTitle>pay_attention</AssemblyTitle>
    <Description>Windows text-triggered screen logger</Description>
    <Copyright>Copyright © tps01</Copyright>
    <Version>1.4.2</Version>
    <FileVersion>1.4.2.0</FileVersion>
    <InformationalVersion>1.4.2</InformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PayAttention.Core\PayAttention.Core.csproj" />
    <ProjectReference Include="..\PayAttention.Capture\PayAttention.Capture.csproj" />
  </ItemGroup>

</Project>
