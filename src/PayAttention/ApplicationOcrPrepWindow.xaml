<Window x:Class="PayAttention.ApplicationOcrPrepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR prep for application"
        Height="360" Width="460"
        MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>

    <StackPanel>
      <TextBlock x:Name="SubtitleText" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="0,0,0,12"
                 Text="Inherit uses the global Advanced toggles. Auto samples this app’s colors to enable neon/adaptive/terminal when the frame looks like a dark or neon UI. Gray Auto stays off (plain gray rarely helps beyond adaptive/neon)." />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Adaptive" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox x:Name="AdaptiveBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Width="160" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Neon" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox x:Name="NeonBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Width="160" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Gray" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox x:Name="GrayBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Width="160" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Invert" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox x:Name="InvertBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Width="160" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Terminal ROI" VerticalAlignment="Center" />
        <ComboBox x:Name="TerminalBox" Grid.Row="4" Grid.Column="1" Width="160" HorizontalAlignment="Left" />
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
