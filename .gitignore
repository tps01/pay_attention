## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esult*/
artifacts/
publish/

# .NET
project.lock.json
project.fragment.lock.json
*.nupkg
packages/
*.exe
*.pdb
*.dll
!scripts/**

# Captures / media (app defaults: JPEG screenshots, AVI/GIF recordings)
captures/
*.avi
*.gif
*.png
*.jpg
*.jpeg
*.webp
# Allow docs assets if added later
!docs/
!docs/**

# Local secrets / machine config
.env
.env.*
*.local.json

# Python / pytest
.pytest_cache/
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/

# Colosseum (run artifacts: debug.log, execution.sqlite, summary, WATS, captures)
outputs/

# Logs
*.log

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Rider / VS / VS Code
.idea/
.vs/
.vscode/*
!.vscode/extensions.json
